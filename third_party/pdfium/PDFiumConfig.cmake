# Pinned, local-only PDFium imported target. Acquisition is an explicit build step.
include(FindPackageHandleStandardArgs)
if(ANDROID)
    message(FATAL_ERROR "No pinned Android PDFium artifacts exist for this build. Desktop PDFium must not be linked into Android.")
elseif(WIN32)
    set(_pdfium_platform win)
elseif(APPLE)
    set(_pdfium_platform mac)
else()
    set(_pdfium_platform linux)
endif()
if(DEFINED PDFINITY_PDFIUM_VARIANT AND NOT PDFINITY_PDFIUM_VARIANT STREQUAL "")
    if(NOT _pdfium_platform STREQUAL "linux" OR NOT PDFINITY_PDFIUM_VARIANT STREQUAL "linux-rpm")
        message(FATAL_ERROR "Unsupported PDFium variant for this platform: ${PDFINITY_PDFIUM_VARIANT}")
    endif()
    set(_pdfium_platform linux-rpm)
endif()
if(NOT APPLE AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
    message(FATAL_ERROR "Pinned PDFium supports x86_64 on this platform; requested ${CMAKE_SYSTEM_PROCESSOR}. Supply reviewed artifacts before adding an architecture.")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependency-lock.json" _pdfium_lock)
string(JSON PDFium_VERSION GET "${_pdfium_lock}" version)
string(JSON _pdfium_count LENGTH "${_pdfium_lock}" platforms ${_pdfium_platform} files)
math(EXPR _pdfium_last "${_pdfium_count} - 1")
foreach(_index RANGE ${_pdfium_last})
    string(JSON _name MEMBER "${_pdfium_lock}" platforms ${_pdfium_platform} files ${_index})
    string(JSON _expected GET "${_pdfium_lock}" platforms ${_pdfium_platform} files "${_name}")
    set(_path "${CMAKE_CURRENT_LIST_DIR}/${_name}")
    if(NOT EXISTS "${_path}" OR IS_SYMLINK "${_path}")
        message(FATAL_ERROR "Pinned PDFium file missing: ${_name}. Run python scripts/download_pdfium.py --platform ${_pdfium_platform} before configuring. Configuration never downloads dependencies.")
    endif()
    file(SHA256 "${_path}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Pinned PDFium SHA-256 mismatch: ${_name}. Re-run python scripts/download_pdfium.py --platform ${_pdfium_platform}; do not reuse this cache.")
    endif()
endforeach()
set(PDFium_INCLUDE_DIR "${CMAKE_CURRENT_LIST_DIR}/include")
if(WIN32)
    set(PDFium_LIBRARY "${CMAKE_CURRENT_LIST_DIR}/bin/pdfium.dll")
    set(PDFium_IMPLIB "${CMAKE_CURRENT_LIST_DIR}/lib/pdfium.dll.lib")
elseif(APPLE)
    set(PDFium_LIBRARY "${CMAKE_CURRENT_LIST_DIR}/lib/libpdfium.dylib")
else()
    set(PDFium_LIBRARY "${CMAKE_CURRENT_LIST_DIR}/lib/libpdfium.so")
endif()
find_package_handle_standard_args(PDFium REQUIRED_VARS PDFium_LIBRARY PDFium_INCLUDE_DIR VERSION_VAR PDFium_VERSION)
if(NOT TARGET pdfium)
    add_library(pdfium SHARED IMPORTED)
    set_target_properties(pdfium PROPERTIES IMPORTED_LOCATION "${PDFium_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${PDFium_INCLUDE_DIR};${PDFium_INCLUDE_DIR}/cpp")
    if(WIN32)
        set_target_properties(pdfium PROPERTIES IMPORTED_IMPLIB "${PDFium_IMPLIB}")
    endif()
endif()
