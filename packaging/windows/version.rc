#include <windows.h>

#define VER_FILEVERSION             1,0,5,0
#define VER_FILEVERSION_STR         "1.0.5.0\0"
#define VER_PRODUCTVERSION          1,0,5,0
#define VER_PRODUCTVERSION_STR      "1.0.5 Stable\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_FILEVERSION
PRODUCTVERSION  VER_PRODUCTVERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "StackSync Solutions\0"
            VALUE "FileDescription",  "PDFinity - Professional Offline-First PDF Productivity Suite\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "PDFinity.exe\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 StackSync Solutions & Jake Ashley Panlilio\0"
            VALUE "OriginalFilename", "PDFinity.exe\0"
            VALUE "ProductName",      "PDFinity\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "Comments",         "Lead Programmer: Jake Ashley Panlilio (https://github.com/jakepanlilio2000). License: Mozilla Public License Version 2.0 (MPL-2.0).\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
