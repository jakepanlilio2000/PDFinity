# Maintainer: Jake Ashley Panlilio <jakepanlilio2000@users.noreply.github.com>
# Contributor: StackSync Solutions <support@stacksyncsolutions.com>
pkgname=pdfinity
pkgver=1.0.7
pkgrel=1
pkgdesc="Professional, modular, offline-first PDF productivity suite"
arch=('x86_64' 'aarch64')
url="https://www.stacksyncsolutions.com/"
license=('MPL-2.0')
depends=('qt6-base' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja')
optdepends=(
    'tesseract: for offline Optical Character Recognition (OCR)'
    'libreoffice: for Office document format conversion'
)
source=("https://github.com/jakepanlilio2000/PDFinity/archive/v0.1-beta.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B "${srcdir}/build" -S "${srcdir}/PDFinity-0.1-beta" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "${srcdir}/build"
}

check() {
    ctest --test-dir "${srcdir}/build" --output-on-failure
}

package() {
    DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
}
