<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.stacksyncsolutions.pdfinity"
    android:versionCode="1"
    android:versionName="0.1.8-Beta">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <!-- Storage Permissions for Legacy Compatibility (Modern Android leverages SAF exclusively) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Network strictly for local loopback IPC (MCP / Remote Controller) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Hardware Acceleration & Touch Screen Support -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.stacksyncsolutions.pdfinity.PDFinityActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <!-- Main Launcher Intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- View / Open PDF File Intent -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Send / Share PDF Intent -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Qt Metadata Configuration -->
            <meta-data android:name="android.app.lib_name" android:value="PDFinity" />
            <meta-data android:name="android.app.arguments" android:value="" />
            <meta-data android:name="android.app.extract_android_style" android:value="minimal" />
        </activity>

        <!-- Secure FileProvider for System Printing and External Sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.stacksyncsolutions.pdfinity.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
